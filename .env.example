# Local client configuration after the SSH tunnel is running.
# Copy this file to .env and replace only the placeholder values.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=replace-with-the-random-vllm-api-key
# Optional pod-side alias; the scripts accept either key name.
VLLM_API_KEY=replace-with-the-same-random-vllm-api-key
MODEL_ID=Qwen/Qwen3.5-9B
MODEL_REVISION=replace-with-full-hugging-face-commit-sha

# Used only by infra/runpod/open_tunnel.sh; do not commit its real values.
RUNPOD_SSH_HOST=replace-with-public-ip-or-hostname
RUNPOD_SSH_PORT=replace-with-external-ssh-port
RUNPOD_SSH_KEY_PATH=/absolute/path/to/private/key
